# UniOps production env for docker-compose.prod.yml (application server 10.10.50.65).
# Copy to `.env` and fill in real values. Do NOT commit the filled-in .env.
#
# Access model: single 443 entry. The Caddy `edge` proxy terminates TLS with the
# company wildcard cert (./certs/*.pem) and routes <module>.canadaroyalmilk.com /
# <api>-api.canadaroyalmilk.com to the containers. Both internal and external
# browsers use the same HTTPS domains (split-DNS or firewall hairpin →
# 10.10.50.65:443). These *_URL values are baked into the bundles at BUILD time.

# ── Image registry + tag ──────────────────────────────────────────────────────
REGISTRY=ghcr.io/wangjustincrm
TAG=latest                     # use the git short SHA per release for rollback

# ── Backend: external infra (DB server + File server) ─────────────────────────
DB_HOST=10.10.50.20                                  # PostgreSQL host (DB server)
DB_PASSWORD=__set_me__                               # epms DB password (same as local .env DB_PASSWORD)
REDIS_HOST=10.10.50.20                               # Redis host (DB server)
REDIS_PASSWORD=                                      # optional; blank = unauthenticated (current prod state). Only set AFTER `requirepass` is configured on the Redis instance itself — setting this before that just sends an unused password, but setting `requirepass` on Redis before this is deployed WILL break login.
JWT_SECRET_KEY=__same_strong_secret_on_all_services__
FILE_SERVER_INTERNAL_URL=http://10.10.50.66:8005/files/v1   # file-api on the File server (server-to-server)
ERP_BASE_URL=http://10.10.95.66                      # mdm-api → ERP
ANTHROPIC_API_KEY=                                   # optional, expense-api receipt OCR

# WMS (Flux) Oracle read-only connection — mrp-api's inventory-lot sync.
# docker-compose.prod.yml reads these as ${WMS_HOST:-} etc.; leaving them
# blank does not fail the deploy, it just leaves the sync endpoint reporting
# "not configured" (503) until real values are filled in. See DEPLOYMENT.md's
# "MRP Module Release Steps".
WMS_HOST=
WMS_PORT=1521
WMS_SERVICE=
WMS_USER=
WMS_PASSWORD=

# Legacy PMS (SharePoint) import — enables epms-api admin "PMS Data Import" page.
# Same service-account values as local epms-api/.env. Leave blank to disable.
SP_USER=appuser@canadaroyalmilk.ca                   # SharePoint service account (ROPC)
SP_PASSWORD=__set_me__                                # same as local epms-api/.env SP_PASSWORD;
                                                     #   IMPORTANT: docker-compose .env interpolates '$',
                                                     #   so escape each literal '$' as '$$' (e.g. Crm12#$56 -> Crm12#$$56)
# SP_TENANT / SP_SITE default to canadaroyalmilk.ca / .../sites/pr2 (config.py)

# CORS — JSON array of the frontend origins the browser will use (HTTPS subdomains).
ALLOWED_ORIGINS=["https://portal.canadaroyalmilk.com","https://epms.canadaroyalmilk.com","https://oa.canadaroyalmilk.com","https://vms.canadaroyalmilk.com","https://finance.canadaroyalmilk.com","https://booking.canadaroyalmilk.com"]

# ── Public frontend URLs (subdomain per module, HTTPS) ────────────────────────
PORTAL_URL=https://portal.canadaroyalmilk.com
EPMS_URL=https://epms.canadaroyalmilk.com
OA_URL=https://oa.canadaroyalmilk.com
VMS_URL=https://vms.canadaroyalmilk.com
FINANCE_URL=https://finance.canadaroyalmilk.com
BOOKING_URL=https://booking.canadaroyalmilk.com

# ── Browser-facing API base URLs (subdomain per API, HTTPS) ───────────────────
# *_API_URL are bare bases; the frontend code appends the version/path prefix.
EPMS_API_URL=https://epms-api.canadaroyalmilk.com
EPMS_VITE_API_URL=https://epms-api.canadaroyalmilk.com/api/v1   # EPMS's own client expects the versioned path
OA_API_URL=https://oa-api.canadaroyalmilk.com
VMS_API_URL=https://vms-api.canadaroyalmilk.com
FINANCE_API_URL=https://finance-api.canadaroyalmilk.com
BUDGET_API_URL=https://budget-api.canadaroyalmilk.com
MDM_API_URL=https://mdm-api.canadaroyalmilk.com
FILE_SERVER_URL=https://files.canadaroyalmilk.com    # file-api via the edge proxy → File server
BOOKING_API_URL=https://booking-api.canadaroyalmilk.com
