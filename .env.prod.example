# UniOps production env for docker-compose.prod.yml (application server).
# Copy to `.env` and fill in real values. Do NOT commit the filled-in .env.
#
# These URLs are BROWSER-FACING (Vite inlines them into the static bundle at
# build time). Use the public address(es) the user's browser can reach —
# typically your prod domain via the reverse proxy, e.g. https://uniops.example.com.

# ── Image registry + tag ──────────────────────────────────────────────────────
REGISTRY=registry.example.com/uniops
TAG=latest                     # use a git SHA in CI for pinned, rollback-able releases

# ── Backend: external infra (DB server + File server) ─────────────────────────
DB_HOST=10.10.50.20                                  # PostgreSQL host (DB server)
DB_PASSWORD=__set_me__                               # epms DB password (same as local .env DB_PASSWORD)
REDIS_HOST=10.10.50.20                               # Redis host (DB server)
JWT_SECRET_KEY=__same_strong_secret_on_all_services__
FILE_SERVER_INTERNAL_URL=http://10.10.50.66:8005/files/v1   # file-api on the File server
ERP_BASE_URL=http://10.10.95.66                      # mdm-api → ERP
ANTHROPIC_API_KEY=                                   # optional, expense-api receipt OCR

# CORS — JSON array of the frontend origins the browser will use (prod domains).
ALLOWED_ORIGINS=["https://portal.example.com","https://epms.example.com","https://oa.example.com","https://vms.example.com","https://finance.example.com"]

# ── Public module URLs (where each frontend is served) ────────────────────────
PORTAL_URL=https://portal.example.com
EPMS_URL=https://epms.example.com
OA_URL=https://oa.example.com
VMS_URL=https://vms.example.com
FINANCE_URL=https://finance.example.com

# ── Browser-facing API base URLs ──────────────────────────────────────────────
# EPMS_API_URL is the bare base (used by portal/oa/vms as VITE_EPMS_API_URL).
EPMS_API_URL=https://epms.example.com
# EPMS's own client expects the versioned path:
EPMS_VITE_API_URL=https://epms.example.com/api/v1
OA_API_URL=https://oa.example.com
VMS_API_URL=https://vms.example.com
FINANCE_API_URL=https://finance.example.com
BUDGET_API_URL=https://epms.example.com:8007
MDM_API_URL=https://epms.example.com:8002
FILE_SERVER_URL=https://files.example.com
