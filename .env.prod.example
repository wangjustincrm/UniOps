# UniOps production env for docker-compose.prod.yml (application server).
# Copy to `.env` and fill in real values. Do NOT commit the filled-in .env.
#
# Layout: subdomain per module. The *_URL values are BROWSER-FACING (Vite inlines
# them into the static bundle at BUILD time), so set them to the real public
# subdomains before building. Replace `uniops.example.com` everywhere with your
# base domain (must match DOMAIN below + the Caddyfile).

# ── Image registry + tag ──────────────────────────────────────────────────────
REGISTRY=ghcr.io/wangjustincrm
TAG=latest                     # use the git short SHA per release for rollback

# ── Edge reverse proxy ────────────────────────────────────────────────────────
# Base domain; Caddy serves portal.${DOMAIN}, epms.${DOMAIN}, epms-api.${DOMAIN}…
DOMAIN=uniops.example.com

# ── Backend: external infra (DB server + File server) ─────────────────────────
DB_HOST=10.10.50.20                                  # PostgreSQL host (DB server)
DB_PASSWORD=__set_me__                               # epms DB password (same as local .env DB_PASSWORD)
REDIS_HOST=10.10.50.20                               # Redis host (DB server)
JWT_SECRET_KEY=__same_strong_secret_on_all_services__
FILE_SERVER_INTERNAL_URL=http://10.10.50.66:8005/files/v1   # file-api on the File server (server-to-server)
ERP_BASE_URL=http://10.10.95.66                      # mdm-api → ERP
ANTHROPIC_API_KEY=                                   # optional, expense-api receipt OCR

# CORS — JSON array of the frontend origins the browser will use (prod subdomains).
ALLOWED_ORIGINS=["https://portal.uniops.example.com","https://epms.uniops.example.com","https://oa.uniops.example.com","https://vms.uniops.example.com","https://finance.uniops.example.com"]

# ── Public frontend URLs (subdomain per module) ───────────────────────────────
PORTAL_URL=https://portal.uniops.example.com
EPMS_URL=https://epms.uniops.example.com
OA_URL=https://oa.uniops.example.com
VMS_URL=https://vms.uniops.example.com
FINANCE_URL=https://finance.uniops.example.com

# ── Browser-facing API base URLs (subdomain per API) ──────────────────────────
# *_API_URL are bare bases; the frontend code appends the version/path prefix.
EPMS_API_URL=https://epms-api.uniops.example.com
EPMS_VITE_API_URL=https://epms-api.uniops.example.com/api/v1   # EPMS's own client expects the versioned path
OA_API_URL=https://oa-api.uniops.example.com
VMS_API_URL=https://vms-api.uniops.example.com
FINANCE_API_URL=https://finance-api.uniops.example.com
BUDGET_API_URL=https://budget-api.uniops.example.com
MDM_API_URL=https://mdm-api.uniops.example.com
FILE_SERVER_URL=https://files.uniops.example.com
