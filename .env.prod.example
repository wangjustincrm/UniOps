# UniOps production env for docker-compose.prod.yml (application server 10.10.50.65).
# Copy to `.env` and fill in real values. Do NOT commit the filled-in .env.
#
# Access model: all modules + APIs are reached by the browser at the app server's
# internal IP + port (http://10.10.50.65:<port>). The firewall's Server Mapping
# exposes ONLY Portal (5174) to the public IP; DNS main domain → public IP →
# 10.10.50.65:5174 (TLS terminated at the firewall). These *_URL values are baked
# into the static bundles at BUILD time, so they must be the real addresses the
# browser will use before you build.

# ── Image registry + tag ──────────────────────────────────────────────────────
REGISTRY=ghcr.io/wangjustincrm
TAG=latest                     # use the git short SHA per release for rollback

# ── Backend: external infra (DB server + File server) ─────────────────────────
DB_HOST=10.10.50.20                                  # PostgreSQL host (DB server)
DB_PASSWORD=__set_me__                               # epms DB password (same as local .env DB_PASSWORD)
REDIS_HOST=10.10.50.20                               # Redis host (DB server)
JWT_SECRET_KEY=__same_strong_secret_on_all_services__
FILE_SERVER_INTERNAL_URL=http://10.10.50.66:8005/files/v1   # file-api on the File server (server-to-server)
ERP_BASE_URL=http://10.10.95.66                      # mdm-api → ERP
ANTHROPIC_API_KEY=                                   # optional, expense-api receipt OCR

# CORS — JSON array of the frontend origins the browser will use (internal IP:port).
ALLOWED_ORIGINS=["http://10.10.50.65:5173","http://10.10.50.65:5174","http://10.10.50.65:5175","http://10.10.50.65:5176","http://10.10.50.65:5177"]

# ── Public frontend URLs (internal IP:port — modules jump by IP) ──────────────
PORTAL_URL=http://10.10.50.65:5174
EPMS_URL=http://10.10.50.65:5173
OA_URL=http://10.10.50.65:5175
VMS_URL=http://10.10.50.65:5176
FINANCE_URL=http://10.10.50.65:5177

# ── Browser-facing API base URLs (internal IP:port) ───────────────────────────
# *_API_URL are bare bases; the frontend code appends the version/path prefix.
EPMS_API_URL=http://10.10.50.65:8000
EPMS_VITE_API_URL=http://10.10.50.65:8000/api/v1     # EPMS's own client expects the versioned path
OA_API_URL=http://10.10.50.65:8006                   # expense-api
VMS_API_URL=http://10.10.50.65:8008
FINANCE_API_URL=http://10.10.50.65:8004
BUDGET_API_URL=http://10.10.50.65:8007
MDM_API_URL=http://10.10.50.65:8002
FILE_SERVER_URL=http://10.10.50.66:8005              # file-api on the File server (browser-facing)
