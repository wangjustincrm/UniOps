# Expense API — Environment Variables
# Copy to .env and fill in values

# ─── Database ────────────────────────────────────────────────────────────────
# Dev (local Docker Compose)
DATABASE_URL=postgresql+asyncpg://epms:epms_dev@localhost:5432/epms
# Prod (database server)
# DATABASE_URL=postgresql+asyncpg://epms:{password}@{db-server}:5432/epms

# ─── Auth (shared across all UniOps services) ─────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# ─── Cross-service URLs ──────────────────────────────────────────────────────
# Dev
APPROVAL_ENGINE_URL=http://localhost:8003/approval/v1
FILE_SERVER_URL=http://localhost:8005/files/v1
EPMS_API_URL=http://localhost:8000/api/v1
BUDGET_API_URL=http://localhost:8007
# Prod
# APPROVAL_ENGINE_URL=http://{app-server-1}:8003/approval/v1
# FILE_SERVER_URL=http://{file-server}:8005/files/v1
# EPMS_API_URL=http://{app-server-1}:8000/api/v1

# ─── Claude API (for OCR) ────────────────────────────────────────────────────
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Service Config ──────────────────────────────────────────────────────────
APP_NAME=Expense API
DEBUG=false
ENVIRONMENT=development
PORT=8006
SERVICE_NAME=expense-api
