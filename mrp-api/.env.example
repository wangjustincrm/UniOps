# ─── Dev (local Docker Compose) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=epms
POSTGRES_PASSWORD=epms_dev
POSTGRES_DB=epms

# ─── Prod (production servers) ─────────────────────────────────────
# POSTGRES_HOST=db.internal
# POSTGRES_PASSWORD={prod_password}

# ─── Cross-service URLs ────────────────────────────────────────────
APPROVAL_API_URL=http://localhost:8003/approval/v1
EPMS_API_URL=http://localhost:8000

# ─── Shared auth ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# ─── App ───────────────────────────────────────────────────────────
APP_NAME=UniOps MRP API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ─── WMS (Flux) Oracle read-only connection ────────────────────────
# WMS Oracle server is <=11g — python-oracledb thin mode fails (DPY-3010),
# so mrp-api uses thick mode via the Instant Client baked into the Dockerfile.
# WMS_HOST=
# WMS_PORT=1521
# WMS_SERVICE=
# WMS_USER=
# WMS_PASSWORD=
ORACLE_CLIENT_LIB=/opt/oracle/instantclient_19_28
