# OA Frontend — Environment Variables
# Copy to .env before npm run dev

# Expense API backend
VITE_API_URL=http://localhost:8006

# Portal URL (for "Back to UniOps Portal" link)
VITE_PORTAL_URL=http://localhost:5174

# EPMS API URL (for vendor / PO lookups)
VITE_EPMS_API_URL=http://localhost:8000

# Budget API URL (for budget account dropdown / hierarchy)
VITE_BUDGET_API_URL=http://localhost:8007
