# UniOps edge reverse proxy (Caddy) — subdomain per module, automatic HTTPS.
#
# {$DOMAIN} comes from the `edge` service env (set DOMAIN in .env, e.g.
# DOMAIN=uniops.crm.example.com). Caddy auto-provisions Let's Encrypt certs for
# each subdomain — requires public DNS A records for *.{$DOMAIN} pointing at this
# server and ports 80/443 reachable. For an INTERNAL domain (no public DNS),
# replace the per-site TLS with `tls internal` (Caddy's local CA) or your certs.
#
# Caddy reaches the app containers by service name on the compose network, so the
# web/api services don't need host-published ports.

# ── Frontends (nginx :80 in each web image) ───────────────────────────────────
portal.{$DOMAIN}   { reverse_proxy portal-web:80 }
epms.{$DOMAIN}     { reverse_proxy epms-web:80 }
oa.{$DOMAIN}       { reverse_proxy oa-web:80 }
vms.{$DOMAIN}      { reverse_proxy vms-web:80 }
finance.{$DOMAIN}  { reverse_proxy finance-web:80 }

# ── Browser-facing APIs ───────────────────────────────────────────────────────
# (approval-api + identity-api are server-to-server only → no public subdomain.)
epms-api.{$DOMAIN}     { reverse_proxy epms-api:8000 }
oa-api.{$DOMAIN}       { reverse_proxy expense-api:8006 }
vms-api.{$DOMAIN}      { reverse_proxy vms-api:8008 }
finance-api.{$DOMAIN}  { reverse_proxy finance-api:8004 }
budget-api.{$DOMAIN}   { reverse_proxy budget-api:8007 }
mdm-api.{$DOMAIN}      { reverse_proxy mdm-api:8002 }
