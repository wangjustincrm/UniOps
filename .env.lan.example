# UniOps production env — INTERNAL LAN mode (no domain, no TLS, no Caddy).
# Copy to `.env` and fill real values. Do NOT commit the filled-in .env.
#
# Browsers reach modules + APIs directly at http://10.10.50.65:<port>. Those URLs
# are baked into the `-lan` image set at build time; at deploy time only TAG,
# ALLOWED_ORIGINS, and the DB/infra values below matter (the browser-facing *_URL
# are NOT read by the running backends). Start WITHOUT the edge profile:
#   docker compose -f docker-compose.prod.yml up -d
#
# Ports: portal 5174 · epms 5173 · oa 5175 · vms 5176 · finance 5177 · mrp 5179 · inventory 5181
#        epms-api 8000 · mdm 8002 · finance 8004 · oa(expense) 8006 · budget 8007 · vms 8008 · mrp-api 8011 · inventory-api 8013
#        sales 5182 · sales-api 8014

REGISTRY=ghcr.io/wangjustincrm
TAG=90303d8-lan                 # the internal IP:port image set

# ── Backend: external infra (DB server + File server) ─────────────────────────
DB_HOST=10.10.50.20
DB_PASSWORD=__set_me__                               # epms DB password
REDIS_HOST=10.10.50.20
REDIS_PASSWORD=                                      # optional; blank = unauthenticated (current prod state). See .env.prod.example for rollout order.
JWT_SECRET_KEY=__same_strong_secret_on_all_services__
FILE_SERVER_INTERNAL_URL=http://10.10.50.66:8005/files/v1
ERP_BASE_URL=http://10.10.95.66
ANTHROPIC_API_KEY=

# WMS (Flux) Oracle read-only connection — mrp-api's inventory-lot sync.
# docker-compose.prod.yml reads these as ${WMS_HOST:-} etc.; leaving them
# blank does not fail the deploy, it just leaves the sync endpoint reporting
# "not configured" (503) until real values are filled in. See DEPLOYMENT.md's
# "MRP Module Release Steps".
WMS_HOST=
WMS_PORT=1521
WMS_SERVICE=
WMS_USER=
WMS_PASSWORD=

# CORS — the frontend origins the browser uses (internal IP:port).
ALLOWED_ORIGINS=["http://10.10.50.65:5173","http://10.10.50.65:5174","http://10.10.50.65:5175","http://10.10.50.65:5176","http://10.10.50.65:5177","http://10.10.50.65:5179","http://10.10.50.65:5181","http://10.10.50.65:5182"]

# The following are BUILD-TIME only (already baked into the -lan images). Kept
# here just so `docker compose` doesn't warn about unset vars at deploy time.
PORTAL_URL=http://10.10.50.65:5174
EPMS_URL=http://10.10.50.65:5173
OA_URL=http://10.10.50.65:5175
VMS_URL=http://10.10.50.65:5176
FINANCE_URL=http://10.10.50.65:5177
MRP_URL=http://10.10.50.65:5179
INVENTORY_URL=http://10.10.50.65:5181
SALES_URL=http://10.10.50.65:5182
EPMS_API_URL=http://10.10.50.65:8000
EPMS_VITE_API_URL=http://10.10.50.65:8000/api/v1
OA_API_URL=http://10.10.50.65:8006
VMS_API_URL=http://10.10.50.65:8008
FINANCE_API_URL=http://10.10.50.65:8004
BUDGET_API_URL=http://10.10.50.65:8007
MDM_API_URL=http://10.10.50.65:8002
FILE_SERVER_URL=http://10.10.50.66:8005
MRP_API_URL=http://10.10.50.65:8011
INVENTORY_API_URL=http://10.10.50.65:8013
SALES_API_URL=http://10.10.50.65:8014
# Sales: scheduler and the two prod-only outbound switches (design §5.5).
# Keep all three false until the cutover decision; only the real .env.prod
# may set them true. While false, nothing reaches a partner or an outside mailbox.
SALES_SCHEDULER_ENABLED=false
SALES_EXTERNAL_EMAIL_ENABLED=false
SALES_PARTNER_WRITES_ENABLED=false
# Sales: the SFTP hosts this server may connect to, comma-separated. Empty =
# no SFTP connection at all (fail closed, design §5.1). List the partner hosts
# explicitly at the release that turns intake on, e.g.
#   SALES_SFTP_ALLOWED_HOSTS=commhub.wheelsgroup.com,sftp.truecommerce.com
SALES_SFTP_ALLOWED_HOSTS=
# Sales: the SFTP hosts a put / move / delete may touch (P4); empty = none.
SALES_SFTP_WRITE_HOSTS=
# Sales (P6): the external mail account for invoice emails — spec X3, revised
# 2026-11-02: env (to keep the module boundary), copied at the release from
# epms company_config po_smtp_*. Empty host = no mail server. The password goes
# in SALES_SECRET_SMTP (the real .env only). Nothing is sent while
# SALES_EXTERNAL_EMAIL_ENABLED=false.
SALES_SMTP_HOST=
SALES_SMTP_PORT=587
SALES_SMTP_USER=
SALES_SMTP_FROM=
SALES_SMTP_STARTTLS=true
SALES_SECRET_SMTP=
