# UniOps production env — INTERNAL LAN mode (no domain, no TLS, no Caddy).
# Copy to `.env` and fill real values. Do NOT commit the filled-in .env.
#
# Browsers reach modules + APIs directly at http://10.10.50.65:<port>. Those URLs
# are baked into the `-lan` image set at build time; at deploy time only TAG,
# ALLOWED_ORIGINS, and the DB/infra values below matter (the browser-facing *_URL
# are NOT read by the running backends). Start WITHOUT the edge profile:
#   docker compose -f docker-compose.prod.yml up -d
#
# Ports: portal 5174 · epms 5173 · oa 5175 · vms 5176 · finance 5177
#        epms-api 8000 · mdm 8002 · finance 8004 · oa(expense) 8006 · budget 8007 · vms 8008

REGISTRY=ghcr.io/wangjustincrm
TAG=90303d8-lan                 # the internal IP:port image set

# ── Backend: external infra (DB server + File server) ─────────────────────────
DB_HOST=10.10.50.20
DB_PASSWORD=__set_me__                               # epms DB password
REDIS_HOST=10.10.50.20
REDIS_PASSWORD=                                      # optional; blank = unauthenticated (current prod state). See .env.prod.example for rollout order.
JWT_SECRET_KEY=__same_strong_secret_on_all_services__
FILE_SERVER_INTERNAL_URL=http://10.10.50.66:8005/files/v1
ERP_BASE_URL=http://10.10.95.66
ANTHROPIC_API_KEY=

# WMS (Flux) Oracle read-only connection — mrp-api's inventory-lot sync.
# docker-compose.prod.yml reads these as ${WMS_HOST:-} etc.; leaving them
# blank does not fail the deploy, it just leaves the sync endpoint reporting
# "not configured" (503) until real values are filled in. See DEPLOYMENT.md's
# "MRP Module Release Steps".
WMS_HOST=
WMS_PORT=1521
WMS_SERVICE=
WMS_USER=
WMS_PASSWORD=

# CORS — the frontend origins the browser uses (internal IP:port).
ALLOWED_ORIGINS=["http://10.10.50.65:5173","http://10.10.50.65:5174","http://10.10.50.65:5175","http://10.10.50.65:5176","http://10.10.50.65:5177"]

# The following are BUILD-TIME only (already baked into the -lan images). Kept
# here just so `docker compose` doesn't warn about unset vars at deploy time.
PORTAL_URL=http://10.10.50.65:5174
EPMS_URL=http://10.10.50.65:5173
OA_URL=http://10.10.50.65:5175
VMS_URL=http://10.10.50.65:5176
FINANCE_URL=http://10.10.50.65:5177
EPMS_API_URL=http://10.10.50.65:8000
EPMS_VITE_API_URL=http://10.10.50.65:8000/api/v1
OA_API_URL=http://10.10.50.65:8006
VMS_API_URL=http://10.10.50.65:8008
FINANCE_API_URL=http://10.10.50.65:8004
BUDGET_API_URL=http://10.10.50.65:8007
MDM_API_URL=http://10.10.50.65:8002
FILE_SERVER_URL=http://10.10.50.66:8005
