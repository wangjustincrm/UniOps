# ─── Database (shared UniOps database) ─────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=epms
POSTGRES_PASSWORD=epms_dev
POSTGRES_DB=epms

# ─── Shared auth ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# ─── App ───────────────────────────────────────────────────────────
APP_NAME=%%service_title%%
DEBUG=true
ENVIRONMENT=development

# ─── Scheduler ─────────────────────────────────────────────────────
%%env_prefix%%_SCHEDULER_ENABLED=false
