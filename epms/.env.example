# EPMS Frontend — Environment Variables
# Copy this file to .env before running npm run dev

# Backend API URL (epms-api must be running on this port)
# Default uses Vite proxy — works without setting this if epms-api is on :8000
VITE_API_URL=http://localhost:8000

# File Server URL (file-api must be running)
VITE_FILE_SERVER_URL=http://localhost:8005

# Budget API URL (budget-api must be running)
VITE_BUDGET_API_URL=http://localhost:8007

# OA Module URL (Phase 2 — leave commented until OA is deployed)
# VITE_OA_URL=http://localhost:5175

# Portal URL (Phase 2 — leave commented until Portal is deployed)
# VITE_PORTAL_URL=http://localhost:5174
