# file-api/.env.prod.example — 复制成 .env.prod 后填写真实值
#
#   cp .env.prod.example .env.prod
#   nano .env.prod
#
# .env.prod 含密钥, 不要提交到 git (确认 .gitignore 里有 .env.prod)

# ── 数据库 ──────────────────────────────────────────────────────────────────────
# 指向 DB 服务器 10.10.50.20; 密码 = db-server-setup.sh 结尾打印的那个
DATABASE_URL=postgresql+asyncpg://epms:<填DB密码>@10.10.50.20:5432/epms

# ── JWT ─────────────────────────────────────────────────────────────────────────
# !!! 必须与本地所有后端 (尤其 epms-api) 完全一致 !!!
# 否则 file-api 无法验证登录签发的 token, 上传/下载附件会全部 401。
JWT_SECRET_KEY=<填共享生产密钥>
JWT_ALGORITHM=HS256
